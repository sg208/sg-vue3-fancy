{
  "name": "sg-vue3-fancy",
  "author": "Syailendra Ginting",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "version": "0.2.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint:check": "eslint src",
    "lint": "eslint src --fix",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "list": "pnpm run lint:check && pnpm run format:check",
    "fix": "pnpm run lint && pnpm run format",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@tanstack/vue-query": "^5.105.0",
    "@tanstack/vue-query-devtools": "^6.3.6",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "sg208-button": "0.0.18-sg",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "sass": "^1.107.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-auto-import-resolvers": "^3.2.1",
    "vite-plugin-pages": "^0.33.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "vue-demi"
    ]
  }
}
